# Copy to .env for local development with `wrangler pages dev`.
# In production these are set in the Cloudflare Pages dashboard under
# Settings > Environment variables. See docs/HANDOFF.md steps 3 and 4.

# Required. Without it the contact form returns {ok:false,error:"send"}.
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxx

# Optional. Both default to info@bhatoya.com if unset.
CONTACT_TO_EMAIL=info@bhatoya.com
CONTACT_FROM_EMAIL=info@bhatoya.com

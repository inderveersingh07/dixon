---
import Base from "../layouts/Base.astro";
import Breadcrumbs from "../components/Breadcrumbs.astro";
import ContactForm from "../components/ContactForm.astro";
import Testimonials from "../components/Testimonials.astro";
import { business } from "../config/business";

const crumbs = [{ name: "Contact", path: "/contact/" }];
---

<Base
  title="Contact Dixon Masonry | Lake Geneva, WI Mason"
  description="Call (262) 233-0392 or send a few details about your stonework project. Brent typically replies within one business day."
  path="/contact/"
  crumbs={crumbs}
>
  <div class="container">
    <Breadcrumbs crumbs={crumbs} />
  </div>

  <header class="head container">
    <h1>Tell us about your project</h1>
    <p class="lead">
      A rough location and a sentence or two about the job is enough to start.
      Brent reads these himself.
    </p>
  </header>

  <div class="container split">
    <div class="form-col">
      <ContactForm />
    </div>

    <aside class="side">
      <section class="block">
        <h2>Call or text</h2>
        <a class="phone" href={`tel:${business.phone.e164}`}>
          {business.phone.display}
        </a>
        <p class="muted">
          Quickest way to reach him. If he is on a scaffold he will call back.
        </p>
      </section>

      <section class="block">
        <h2>Email</h2>
        <a href={`mailto:${business.email}`}>{business.email}</a>
      </section>

      <section class="block">
        <h2>Where we are</h2>
        <address>
          {business.address.street}<br />
          {business.address.locality}, {business.address.region}
        </address>
        <p class="muted">
          Working across <a href="/lake-geneva-masonry/">Lake Geneva and the
          surrounding lake communities</a>. Not Illinois.
        </p>
      </section>

      <section class="block">
        <h2>Hours</h2>
        <dl class="hours">
          {
            business.hours.display.map((h) => (
              <div>
                <dt>{h.label}</dt>
                <dd>{h.value}</dd>
              </div>
            ))
          }
        </dl>
      </section>

      <section class="block">
        <h2>What helps</h2>
        <ul class="tips">
          <li>Roughly where the property is.</li>
          <li>What you want built or repaired.</li>
          <li>A photo or two, if it is a repair.</li>
          <li>Whether you have a date in mind.</li>
        </ul>
      </section>
    </aside>
  </div>

  <div class="container reviews">
    <Testimonials slugs={["review-6"]} columns={1} />
  </div>
</Base>

<style>
  .head {
    padding-block: var(--space-6) var(--space-7);
  }

  .head .lead {
    margin-block-start: var(--space-5);
  }

  .split {
    display: grid;
    gap: var(--space-8);
    align-items: start;
    padding-block-end: var(--section-y);
  }

  @media (min-width: 60em) {
    .split {
      grid-template-columns: 1.4fr 1fr;
      gap: var(--space-9);
    }
  }

  .side {
    display: grid;
    gap: var(--space-6);
  }

  .block h2 {
    font-family: var(--font-body);
    font-size: var(--text-xs);
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--text-faint);
    margin-block-end: var(--space-3);
  }

  .phone {
    display: inline-block;
    font-size: var(--text-2xl);
    font-family: var(--font-display);
    text-decoration: none;
  }

  .block p {
    margin-block-start: var(--space-3);
    font-size: var(--text-sm);
  }

  address {
    font-style: normal;
  }

  .hours {
    display: grid;
    gap: var(--space-2);
    margin: 0;
    font-size: var(--text-sm);
  }

  .hours div {
    display: flex;
    flex-wrap: wrap;
    gap: 0.15rem 0.5rem;
  }

  .hours dt {
    font-weight: 600;
  }

  .hours dd {
    margin: 0;
    color: var(--text-muted);
  }

  .tips {
    margin: 0;
    padding-inline-start: 1.1rem;
    font-size: var(--text-sm);
    color: var(--text-muted);
    display: grid;
    gap: var(--space-2);
  }

  .reviews {
    padding-block-end: var(--section-y);
  }
</style>

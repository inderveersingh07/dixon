---
import type { QA } from "../lib/schema";

interface Props {
  items: QA[];
  heading?: string;
  id?: string;
}

const { items, heading = "Common questions", id = "faq" } = Astro.props;
---

{
  /* The visible markup and the FAQPage JSON-LD are generated from the same
     `items` array by the page that renders this, so the two cannot drift. */
}
<section class="faq" id={id}>
  <h2>{heading}</h2>
  <div class="list">
    {
      items.map((item, i) => (
        <details name="faq" open={i === 0}>
          <summary>
            <span>{item.q}</span>
            <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true">
              <path
                d="M6 9.5l6 6 6-6"
                fill="none"
                stroke="currentColor"
                stroke-width="1.8"
                stroke-linecap="round"
                stroke-linejoin="round"
              />
            </svg>
          </summary>
          <div class="answer">
            <p>{item.a}</p>
          </div>
        </details>
      ))
    }
  </div>
</section>

<style>
  .faq h2 {
    margin-block-end: var(--space-6);
  }

  .list {
    max-width: var(--measure);
    border-top: 1px solid var(--border);
  }

  details {
    border-bottom: 1px solid var(--border);
  }

  summary {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-4);
    padding-block: var(--space-4);
    min-height: 2.75rem;
    list-style: none;
    cursor: pointer;
    font-family: var(--font-display);
    font-size: var(--text-lg);
    line-height: var(--leading-snug);
  }

  summary::-webkit-details-marker {
    display: none;
  }

  summary svg {
    flex: none;
    color: var(--text-faint);
    transition: transform 0.15s ease;
  }

  details[open] summary svg {
    transform: rotate(180deg);
  }

  .answer {
    padding-block-end: var(--space-5);
    color: var(--text-muted);
  }
</style>

---
import { Image } from "astro:assets";
import logo from "../assets/logo/dixon-masonry.jpg";
import { business } from "../config/business";

interface Props {
  height?: number;
  class?: string;
}

const { height = 56, class: className = "" } = Astro.props;
const width = Math.round(height * 3.8);
---

<span class={`logo ${className}`.trim()} style={`--logo-width: ${width}px; --logo-height: ${height}px;`}>
  <Image
    src={logo}
    alt={`${business.name} logo`}
    width={1536}
    height={768}
    widths={[480, 768, 1536]}
    sizes={`${width}px`}
    loading="eager"
  />
</span>

<style>
  /* Preserve the supplied artwork on its white background in both themes.
     The viewport removes the source image's generous blank margins. */
  .logo {
    display: block;
    flex: none;
    position: relative;
    overflow: hidden;
    width: min(var(--logo-width), 48vw);
    aspect-ratio: 3.8;
    max-width: 100%;
    background: #fff;
    border-radius: 4px;
  }

  .logo :global(img) {
    position: absolute;
    width: 118%;
    max-width: none;
    height: auto;
    left: -9%;
    top: 50%;
    transform: translateY(-50%);
  }
</style>

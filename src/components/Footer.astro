---
import Logo from "./Logo.astro";
import { business, services } from "../config/business";

const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="container">
    <div class="grid">
      <div class="col brand-col">
        <Logo height={62} />
        <p class="muted tagline">{business.tagline}</p>
        <p class="muted est">
          Established {business.foundedYear} in {business.address.locality},
          {business.address.region}.
        </p>
      </div>

      <div class="col">
        <h2 class="col-title">Services</h2>
        <ul class="list">
          {
            services.map((s) => (
              <li>
                <a href={`/${s.slug}/`}>{s.title}</a>
              </li>
            ))
          }
        </ul>
      </div>

      <div class="col">
        <h2 class="col-title">More</h2>
        <ul class="list">
          <li><a href="/gallery/">Stonework gallery</a></li>
          <li><a href="/about/">About Brent Dixon</a></li>
          <li><a href="/lake-geneva-masonry/">Areas we serve</a></li>
          <li><a href="/contact/">Request a quote</a></li>
        </ul>
      </div>

      <div class="col">
        <h2 class="col-title">Get in touch</h2>
        {/* NAP block. Must match the Google Business Profile character for character. */}
        <address class="nap">
          <a class="phone" href={`tel:${business.phone.e164}`}>{business.phone.display}</a>
          <a href={`mailto:${business.email}`}>{business.email}</a>
          <span class="muted">
            {business.address.street}<br />
            {business.address.locality}, {business.address.region}
          </span>
        </address>

        <h3 class="hours-title">Hours</h3>
        <dl class="hours">
          {
            business.hours.display.map((h) => (
              <div class="hours-row">
                <dt>{h.label}</dt>
                <dd>{h.value}</dd>
              </div>
            ))
          }
        </dl>
      </div>
    </div>

    <div class="base">
      <p class="muted">
        &copy; {year} {business.name}. Insured. Serving Lake Geneva and the
        surrounding lake communities.
      </p>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    margin-block-start: auto;
    padding-block: var(--space-8) var(--space-6);
    background: var(--bg-subtle);
    border-top: 1px solid var(--border);
    font-size: var(--text-sm);
  }

  .grid {
    display: grid;
    gap: var(--space-7) var(--space-6);
    grid-template-columns: 1fr;
  }

  @media (min-width: 40em) {
    .grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (min-width: 64em) {
    .grid {
      grid-template-columns: 1.6fr 1fr 1fr 1.3fr;
      gap: var(--space-6);
    }
  }

  .brand-col {
    max-width: 24rem;
  }

  .tagline {
    margin-block-start: var(--space-4);
  }

  .est {
    margin-block-start: var(--space-3);
    font-size: var(--text-xs);
  }

  .col-title {
    font-family: var(--font-body);
    font-size: var(--text-xs);
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--text-faint);
    margin-block-end: var(--space-4);
  }

  .list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: var(--space-3);
  }

  .list a,
  .nap a {
    color: var(--text-muted);
    text-decoration: none;
  }

  .list a:hover,
  .nap a:hover {
    color: var(--text);
    text-decoration: underline;
    text-underline-offset: 0.2em;
  }

  .nap {
    font-style: normal;
    display: grid;
    gap: var(--space-2);
  }

  .phone {
    font-size: var(--text-lg);
    font-weight: 600;
    color: var(--text) !important;
  }

  .hours-title {
    font-family: var(--font-body);
    font-size: var(--text-xs);
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--text-faint);
    margin-block: var(--space-5) var(--space-3);
  }

  .hours {
    display: grid;
    gap: var(--space-2);
    margin: 0;
  }

  .hours-row {
    display: flex;
    flex-wrap: wrap;
    gap: 0.15rem 0.5rem;
  }

  .hours dt {
    color: var(--text);
    font-weight: 500;
  }

  .hours dd {
    margin: 0;
    color: var(--text-muted);
  }

  .base {
    margin-block-start: var(--space-7);
    padding-block-start: var(--space-5);
    border-top: 1px solid var(--border);
    font-size: var(--text-xs);
  }
</style>
